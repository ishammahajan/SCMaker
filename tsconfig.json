{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true,
    "paths": { "/shared/*": ["./shared/*"] }
  },
  "include": ["shared/**/*.js", "server/**/*.js", "public/**/*.js"]
}
